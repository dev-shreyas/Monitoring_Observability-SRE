# Local .terraform directory (contains provider binaries and modules)
**/.terraform/*

# State files (can contain secrets and sensitive infrastructure data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude variable files containing sensitive data (passwords, keys, etc.)
*.tfvars
*.tfvars.json

# Ignore local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore specific plan outputs (if you run: terraform plan -out=tfplan)
*tfplan*
