NODE_ENV=development
PORT=3003
# MUST be the same secret user-service signs with, or every token is rejected.
JWT_SECRET=dev-only-insecure-secret-change-me
SQL_CONNECTION_STRING=dummy-local-connection
# Kubernetes/compose DNS names — not localhost. Empty => use the local stub.
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
# Empty => events are logged instead of published.
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_TOPIC=order-events
